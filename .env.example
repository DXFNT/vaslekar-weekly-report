# Copy to .env and fill in the actual values
# Never commit .env to git

# Netlify (for deploying the report to dexfinity-vaslekar.netlify.app)
NETLIFY_TOKEN=
NETLIFY_SITE_ID=0a40a6e4-e854-4438-b3a2-145112f9d99d

# Basecamp ("Weekly reports comments" thread in Dexfinity & Váš Lekár project)
BASECAMP_ACCOUNT_ID=5020993
BASECAMP_PROJECT_ID=46381488
BASECAMP_MESSAGE_ID=9791306636

# Meta Ads (Marketing API access is via MCP — no static token needed)
META_AD_ACCOUNT_ID=1783827691983346

# Google Ads (scraped via Chrome MCP — no API token needed, but capture the OCID once)
# OCID = the customer-account identifier in ads.google.com URLs. Without it, ads.google.com
# redirects to the business.google.com landing page (= "not logged in" signal).
GADS_OCID=

# Optional: where to write outputs (default: ./dist/)
DIST_DIR=./dist
